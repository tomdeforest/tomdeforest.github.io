source "https://rubygems.org"

# GitHub Pages ignores this Gemfile and builds with its own pinned gem set.
# The github-pages gem pins that same set (Jekyll 3.10, kramdown, sass
# converter, jekyll-paginate, jekyll-sitemap, ...), so local builds match
# production. Bump it when https://pages.github.com/versions/ changes.
gem "github-pages", "~> 233", group: :jekyll_plugins
